<Window x:Class="ReminderNotebook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ReminderNotebook.ViewModels"
        mc:Ignorable="d"
        Title="ReminderNotebook" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White" BorderBrush="#EEEEEE" BorderThickness="0,0,1,0">
            <DockPanel Margin="15">
                <TextBlock DockPanel.Dock="Top" Text="Категорії" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" />

                <Button DockPanel.Dock="Bottom" Content="Статистика" 
                        Style="{StaticResource SecondaryButton}" 
                        Click="OnStatisticsClick" Margin="0,15,0,0" />

                <Button DockPanel.Dock="Bottom" Content="Керувати категоріями" 
                        Style="{StaticResource SecondaryButton}" 
                        Click="OnManageCategoriesClick" Margin="0,15,0,0" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="Всі нотатки" Style="{StaticResource SecondaryButton}" 
                                HorizontalContentAlignment="Left" Margin="0,0,0,5"
                                Click="OnShowAllNotesClick" />

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}" 
                                            HorizontalContentAlignment="Left" Margin="0,0,0,5"
                                            Tag="{Binding Id}"
                                            Click="OnCategoryFilterClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" CornerRadius="6" 
                                                    Background="{Binding ColorHex}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <DockPanel Grid.Column="1" Margin="20">
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Width="300" Padding="5" VerticalAlignment="Center" />
                </DockPanel>

                <Button Grid.Column="1" Content="+ Нова нотатка" 
                        Style="{StaticResource PrimaryButton}" 
                        Click="OnAddNoteClick" />
            </Grid>

            <!-- Notes List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="230" Height="200" Margin="0,0,15,15" 
                                    Background="White" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="OnNoteCardClick" Tag="{Binding}"
                                    Padding="15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1" />
                                </Border.Effect>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <Border HorizontalAlignment="Left" Padding="8,2" CornerRadius="4" Margin="0,0,0,10"
                                                Background="{Binding CategoryColorHex}">
                                            <TextBlock Text="{Binding CategoryName, FallbackValue='Без категорії'}" 
                                                       FontSize="10" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" 
                                                   TextWrapping="Wrap" MaxHeight="45" Margin="0,0,0,5" />
                                        <TextBlock Text="{Binding ContentPreview}" FontSize="12" Foreground="#666666" 
                                                   TextWrapping="Wrap" MaxHeight="60" />
                                    </StackPanel>

                                    <Grid DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource DateTimeFormatConverter}}" 
                                                   FontSize="10" Foreground="#999999" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="✎" Padding="5,0" Background="Transparent" BorderThickness="0" 
                                                    Click="OnEditNoteClick" Tag="{Binding}" />
                                            <Button Content="🗑" Padding="5,0" Background="Transparent" BorderThickness="0" 
                                                    Click="OnDeleteNoteClick" Tag="{Binding}" Foreground="#F44336" />
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>