<Window x:Class="ReminderNotebook.Views.NoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нова нотатка" Height="600" Width="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <!-- Footer Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnCancelClick" />
            <Button Content="Зберегти" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="Заголовок" FontWeight="Bold" Margin="0,0,0,5" />
                <TextBox x:Name="TitleTextBox" Padding="8" FontSize="16" Margin="0,0,0,15" />

                <!-- Category -->
                <TextBlock Text="Категорія" FontWeight="Bold" Margin="0,0,0,5" />
                <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8" Margin="0,0,0,15" />

                <!-- Content -->
                <TextBlock Text="Зміст" FontWeight="Bold" Margin="0,0,0,5" />
                <TextBox x:Name="ContentTextBox" Padding="8" Height="150" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" />

                <!-- Reminders -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Нагадування" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                    <Button Content="+ Додати" Style="{StaticResource SecondaryButton}" 
                            HorizontalAlignment="Right" Click="OnAddReminderClick" />
                </DockPanel>

                <TextBlock x:Name="NoRemindersText" Text="Нагадувань немає" Foreground="#999999" FontStyle="Italic" Margin="0,0,0,10" />

                <ItemsControl x:Name="RemindersItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9F9F9" Padding="10" CornerRadius="4" Margin="0,0,0,8" BorderBrush="#EEEEEE" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Message}" FontWeight="Bold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding TriggerDateTime, Converter={StaticResource DateTimeFormatConverter}}" FontSize="11" />
                                            <Border Margin="10,0,0,0" Padding="5,0" CornerRadius="2" 
                                                    Background="{Binding StatusText, Converter={StaticResource StatusToColorConverter}}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="10" />
                                            </Border>
                                            <TextBlock Text=" 🔁" Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✎" Padding="5,0" Background="Transparent" BorderThickness="0" 
                                                Click="OnEditReminderClick" Tag="{Binding}" />
                                        <Button Content="🗑" Padding="5,0" Background="Transparent" BorderThickness="0" 
                                                Click="OnDeleteReminderClick" Tag="{Binding}" Foreground="#F44336" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>