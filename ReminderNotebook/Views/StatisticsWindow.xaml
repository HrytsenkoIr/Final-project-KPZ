<Window x:Class="ReminderNotebook.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика" Height="320" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid>
        <Border Margin="20" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Статистика нотаток" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <Button DockPanel.Dock="Bottom" Content="Закрити" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Center" Width="100" Margin="0,20,0,0" Click="OnCloseClick"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Загальна кількість:" Margin="0,8" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalCount}" FontWeight="Bold" Margin="0,8" FontSize="14" />

                    <TextBlock Grid.Row="1" Text="Виконано (завершені):" Margin="0,8" FontSize="14" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompletedCount}" FontWeight="Bold" Margin="0,8" FontSize="14" Foreground="#4CAF50" />

                    <TextBlock Grid.Row="2" Text="В очікуванні (активні):" Margin="0,8" FontSize="14" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PendingCount}" FontWeight="Bold" Margin="0,8" FontSize="14" Foreground="#2196F3" />

                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,15" />

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Прогрес виконання: " FontSize="16" />
                        <TextBlock Text="{Binding CompletionPercentage, StringFormat={}{0:F1}%}" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
